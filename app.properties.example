# Copy this file to app.properties and set your own values.
# app.properties is git-ignored, so credentials never get committed.
# Each setting can also come from an environment variable
# (MANAGER_USERNAME, MANAGER_PASSWORD_SHA256, ORDERS_FILE).

manager.username=manager

# SHA-256 of the manager password. Generate your own with:
#   java -cp out restaurant.security.PasswordHasher "your new password"
# The value below is the hash of "changeme" - replace it before real use.
manager.password.sha256=057ba03d6c44104863dc7361fe4578965d1887360f90a0895882e58a6248fc86

# Where the order queue is stored, relative to the working directory.
orders.file=orders.txt
